# -------------------
# Общие настройки приложения для тестов
# -------------------
APP_TITLE=Сервис бронирования столиков (Test)
DESCRIPTION=API для управления сервисом бронирования столиков (Test Environment)
DEBUG=True

# -------------------
# База данных для тестов
# -------------------
DB_ENGINE=postgres
DB_HOST=test-db
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# -------------------
# PostgreSQL
# -------------------
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=test_db
POSTGRES_PORT=5432
POSTGRES_HOST=test-db
POSTGRES_NAME=test_db

# -------------------
# JWT / безопасность для тестов
# -------------------
SECRET=test_secret_key_for_testing_only_do_not_use_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------------------
# Первый суперпользователь для тестов
# -------------------
FIRST_SUPERUSER_EMAIL=test_admin@test.com
FIRST_SUPERUSER_PASSWORD=test_password
FIRST_SUPERUSER_USERNAME=test_admin
FIRST_SUPERUSER_ROLE=admin
FIRST_SUPERUSER_PHONE_NUMBER=+79999999999

# -------------------
# Логирование для тестов
# -------------------
LOG_FILE=test.log
MAX_BYTES=1048576          # 1 MB
BACKUP_COUNT=1
SYSTEM_USERNAME=TEST_SYSTEM

# -------------------
# Прочие настройки для тестов
# -------------------
DEFAULT_USER_ID=0
