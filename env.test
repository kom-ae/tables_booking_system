# Тестовая конфигурация для PostgreSQL в Docker

# Настройки базы данных
DB_ENGINE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password

# PostgreSQL настройки (альтернативные переменные)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=test_db
POSTGRES_NAME=test_db
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password

# JWT и безопасность
SECRET=test_secret_key_for_testing_only_do_not_use_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Настройки повторных попыток БД
DB_RETRY_MAX_ATTEMPTS=3
DB_RETRY_DELAY_SECONDS=1.0

# Логирование
LOG_FILE=test.log
MAX_BYTES=1048576
BACKUP_COUNT=1

# Первый суперпользователь (для тестов)
FIRST_SUPERUSER_USERNAME=test_admin@test.com
FIRST_SUPERUSER_EMAIL=test_admin@test.com
FIRST_SUPERUSER_PASSWORD=TestAdmin123!
FIRST_SUPERUSER_ROLE=admin
FIRST_SUPERUSER_PHONE_NUMBER=+70000000000
